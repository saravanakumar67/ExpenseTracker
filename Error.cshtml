@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="empty-state">
    <h2>Something went wrong</h2>
    <p>An unexpected error occurred while handling your request.</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> @Model.RequestId</p>
    }
</div>
