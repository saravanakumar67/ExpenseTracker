@page
@model ExpenseTracker.Pages.CreateModel
@{
    ViewData["Title"] = "Add expense";
}

<div class="toolbar">
    <h1>Add expense</h1>
</div>

<div class="form-card">
    <form method="post">
        <div asp-validation-summary="ModelOnly"></div>

        <div class="field">
            <label asp-for="Expense.Description"></label>
            <input asp-for="Expense.Description" placeholder="e.g. Groceries at the market" autofocus />
            <span asp-validation-for="Expense.Description" class="validation-error"></span>
        </div>

        <div class="field">
            <label asp-for="Expense.Amount"></label>
            <input asp-for="Expense.Amount" type="number" step="0.01" min="0.01" placeholder="0.00" />
            <span asp-validation-for="Expense.Amount" class="validation-error"></span>
        </div>

        <div class="field">
            <label asp-for="Expense.Category"></label>
            <select asp-for="Expense.Category">
                @foreach (var c in Categories.All)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>

        <div class="field">
            <label asp-for="Expense.Date"></label>
            <input asp-for="Expense.Date" type="date" />
        </div>

        <div class="field">
            <label asp-for="Expense.Notes"></label>
            <textarea asp-for="Expense.Notes" placeholder="Optional detail"></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save expense</button>
            <a asp-page="/Index">Cancel</a>
        </div>
    </form>
</div>
